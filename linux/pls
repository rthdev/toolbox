#!/bin/bash

usage() {
  printf '%s\n' 'Usage: pls [-h|--help]' \
    'List visible conmon container names as owner:name, sorted.' \
    'ps flattens argv: names containing option-like text are ambiguous.'
}
if [[ $# == 1 && ($1 == -h || $1 == --help) ]]; then
  usage
  exit 0
fi
if (( $# )); then
  usage >&2
  exit 2
fi

export LC_ALL=C
set -o pipefail
ps_out=$(ps -ww -eo user:32=,comm=,args=) || exit 1
{
  while read -r owner comm args; do
    [[ $comm == conmon ]] || continue
    executable=${args%%[[:space:]]*}
    [[ ${executable##*/} == conmon ]] || continue
    # Never eval process arguments. Match a complete option, not a substring.
    if [[ $args =~ [[:space:]](-n[[:space:]]+|--name[[:space:]]+|--name=)(.*) ]]; then
      name=${BASH_REMATCH[2]}
      # Keep spaces up to the next option (ps does not retain argv boundaries).
      name=${name%%[[:space:]]-*}
      name=${name%"${name##*[!$'\t ']}"}
      if [[ -n $name && $name != -* ]]; then
        printf '%s:%s\n' "$owner" "$name"
      fi
    fi
  done <<< "$ps_out"
} | sort || exit 1
