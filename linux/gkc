#!/bin/bash

usage() { printf '%s\n' 'Usage: gkc [-h|--help]' 'Check Kustomize builds and direct-entry inclusion in the current directory and its descendants.'; }
if [[ $# == 1 && ($1 == -h || $1 == --help) ]]; then
  usage
  exit 0
fi
if (( $# )); then
  usage >&2
  exit 2
fi

for dependency in find sort oc; do
  command -v "$dependency" >/dev/null || {
    printf 'gkc: required command not found: %s\n' "$dependency" >&2
    exit 1
  }
done
root=$PWD
set -o pipefail
shopt -s lastpipe
# NUL-delimited directories preserve whitespace and deduplicate variant names.
find "$root" -name .git -prune -o -type f \( -name kustomization.yaml -o \
  -name kustomization.yml -o -name Kustomization \) -printf '%h\0' |
  sort -zu | mapfile -d '' -t dirs || exit 1
if (( ${#dirs[@]} == 0 )); then
  printf '%s\n' 'No kustomizations found in the current directory or its descendants.'
  exit 0
fi
failed=0
for dir in "${dirs[@]}"; do
  printf 'Checking %s ...\n' "$dir"
  if oc kustomize "$dir" >/dev/null; then
    printf '%s\n' 'OK'
  else
    printf '%s\n' 'FAILED' >&2
    failed=1
  fi

  # Original direct-entry heuristic: literal text, not YAML interpretation.
  for kfile in "$dir/kustomization.yaml" "$dir/kustomization.yml" "$dir/Kustomization"; do
    [[ -f "$kfile" ]] || continue
    if [[ ! -r "$kfile" ]]; then
      printf 'gkc: cannot read %s\n' "$kfile" >&2
      failed=1
      continue
    fi
    # read preserves trailing newlines; EOF is expected without a NUL delimiter.
    IFS= read -r -d '' content < "$kfile" || :
    for entry in "$dir"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      name=${entry##*/}
      case "$name" in
        kustomization.yaml|kustomization.yml|Kustomization) continue ;;
      esac
      if [[ "$content" != *"$name"* ]]; then
        printf 'gkc: File %s not found in %s\n' "$name" "$kfile" >&2
        failed=1
      fi
    done
  done
done
exit "$failed"
