#!/bin/bash

usage() { printf '%s\n' 'Usage: gkc [-h|--help]' 'Validate every kustomization in the Git working tree with oc kustomize.'; }
if [[ $# == 1 && ($1 == -h || $1 == --help) ]]; then
  usage
  exit 0
fi
if (( $# )); then
  usage >&2
  exit 2
fi

for dependency in git find sort oc; do
  command -v "$dependency" >/dev/null || {
    printf 'gkc: required command not found: %s\n' "$dependency" >&2
    exit 1
  }
done
root=$(git rev-parse --show-toplevel) || exit 1
set -o pipefail
shopt -s lastpipe
# NUL-delimited directories preserve whitespace and deduplicate variant names.
find "$root" -name .git -prune -o -type f \( -name kustomization.yaml -o \
  -name kustomization.yml -o -name Kustomization \) -printf '%h\0' |
  sort -zu | mapfile -d '' -t dirs || exit 1
if (( ${#dirs[@]} == 0 )); then
  printf '%s\n' 'No kustomizations found in repository.'
  exit 0
fi
failed=0
for dir in "${dirs[@]}"; do
  printf 'Checking %s ...\n' "$dir"
  if oc kustomize "$dir" >/dev/null; then
    printf '%s\n' 'OK'
  else
    printf '%s\n' 'FAILED' >&2
    failed=1
  fi
done
exit "$failed"
