#!/usr/bin/env python3
# gencl - generate changelog from git changes

import subprocess
import sys


def run(cmd):
    return subprocess.check_output(cmd, shell=True, text=True).strip()


def get_tags():
    try:
        tags = run("git tag --sort=-v:refname")
        return tags.splitlines() if tags else []
    except subprocess.CalledProcessError:
        return []


def get_log(range_expr):
    try:
      return run(f'git log {range_expr} --oneline --no-merges --no-decorate')
    except subprocess.CalledProcessError:
        return ""


def main():
    new_tag = sys.argv[1] if len(sys.argv) > 1 else "HEAD"
    tags = get_tags()

    print("# Changelog\n")

    # ---- No tags at all ----
    if not tags:
        print(f"## {new_tag}")
        print(get_log(""))
        return

    # ---- HEAD → latest tag ----
    print(f"## {new_tag}")
    print(get_log(f"{tags[0]}..HEAD"))
    print()

    # ---- tag → tag ----
    for i in range(len(tags) - 1):
        current = tags[i]
        previous = tags[i + 1]

        print(f"## {current}")
        print(get_log(f"{previous}..{current}"))
        print()

    # ---- oldest tag → beginning ----
    print(f"## {tags[-1]}")
    print(get_log(tags[-1]))
    print()


if __name__ == "__main__":
    main()
