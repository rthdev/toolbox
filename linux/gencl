#!/usr/bin/env python3
# gencl - generate changelog from git changes

import subprocess
import sys


def run(cmd):
    return subprocess.check_output(cmd, text=True, stderr=subprocess.PIPE).strip()


def get_tags():
    tags = run(["git", "tag", "--sort=-v:refname"])
    return tags.splitlines() if tags else []


def get_log(range_expr):
    revisions = [range_expr] if range_expr else []
    return run(["git", "log", "--oneline", "--no-merges", "--no-decorate",
                *revisions, "--"])


def changelog(new_tag):
    tags = get_tags()
    lines = ["# Changelog", "", f"## {new_tag}"]
    if not tags:
        lines.append(get_log(""))
        return "\n".join(lines) + "\n"

    # Fully qualified refs prevent option injection and branch/path ambiguity.
    lines.extend([get_log(f"refs/tags/{tags[0]}..HEAD"), ""])
    for current, previous in zip(tags, tags[1:]):
        lines.extend([f"## {current}",
                      get_log(f"refs/tags/{previous}..refs/tags/{current}"), ""])
    lines.extend([f"## {tags[-1]}", get_log(f"refs/tags/{tags[-1]}"), ""])
    return "\n".join(lines) + "\n"


USAGE = "Usage: gencl [heading]\nGenerate a changelog; heading labels HEAD (default: HEAD)."


def main():
    args = sys.argv[1:]
    if args in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if len(args) > 1 or (args and args[0].startswith("-")):
        print(f"gencl: expected at most one heading\n{USAGE}", file=sys.stderr)
        return 2
    new_tag = args[0] if args else "HEAD"
    try:
        report = changelog(new_tag)
    except subprocess.CalledProcessError as exc:
        print(f"gencl: Git failed: {exc.stderr.strip()}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"gencl: cannot run Git: {exc}", file=sys.stderr)
        return 1
    # Do not publish a partial changelog if any Git command failed.
    print(report, end="")
    return 0


if __name__ == "__main__":
    sys.exit(main())
