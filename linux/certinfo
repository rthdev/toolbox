#!/bin/bash
set -o pipefail
# shellcheck source=lib/tls.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/../lib/tls.sh" || exit 1
export LC_ALL=C
tls_args "$@"
for dep in sed tr; do
    command -v "$dep" >/dev/null || tls_error "missing dependency: $dep"
done
tls_fetch
subject=$(openssl x509 -in "$TLS_WORK/peer" -noout -subject \
    -nameopt sep_multiline,sname,esc_2253,esc_ctrl,esc_msb,utf8) || tls_error 'cannot parse certificate subject'
# OpenSSL escapes literal plus signs; only the spaced RDN separator is split.
cn=$(printf '%s\n' "$subject" | sed 's/ + /\n/g' | sed -n 's/^ *CN *= *//p') || tls_error 'cannot parse certificate CN'
issuer=$(openssl x509 -in "$TLS_WORK/peer" -noout -issuer -nameopt RFC2253) || tls_error 'cannot parse certificate issuer'
expires=$(openssl x509 -in "$TLS_WORK/peer" -noout -enddate) || tls_error 'cannot parse certificate expiry'
san=$(openssl x509 -in "$TLS_WORK/peer" -noout -ext subjectAltName 2>"$TLS_WORK/parse-errors") || {
    cat "$TLS_WORK/parse-errors" >&2
    tls_error 'cannot parse certificate SANs'
}
san=$(printf '%s\n' "$san" | tr ',' '\n' | sed -n -e 's/^ *DNS:/DNS:/p' -e 's/^ *IP Address:/IP:/p') || tls_error 'cannot parse certificate SANs'
printf 'Host: %s\nPort: %s\n--\n' "$TLS_HOST" "$TLS_PORT"
printf 'CN: %s\nIssuer: %s\n\nExpires: %s\n\nSAN(s):\n%s\n' \
    "${cn:-(none)}" "${issuer#issuer=}" "${expires#notAfter=}" "${san:-(none)}"
