#!/usr/bin/python3
"""qrm - Quay repository management."""

import argparse
import json
import os
from pathlib import Path
import re
import sys
from urllib.parse import quote

import requests

REQUEST_TIMEOUT = (5, 30)
MAX_PAGES = 1000
my_headers = {"Content-type": "application/json"}


def request(method, url, **kwargs):
    try:
        response = method(
            url,
            headers=my_headers.copy(),
            # An explicit no-op auth handler prevents implicit .netrc credentials.
            auth=lambda prepared: prepared,
            timeout=REQUEST_TIMEOUT,
            allow_redirects=False,
            **kwargs,
        )
    except requests.RequestException:
        raise ValueError("Registry request failed (connection, TLS, or timeout)") from None
    if not 200 <= response.status_code < 300:
        raise ValueError("HTTP " + str(response.status_code))
    return response


def responseJSON(response):
    try:
        return response.json()
    except ValueError:
        raise ValueError("Invalid JSON response") from None


def getRepos(registry: str, public: bool):
    next_page = ""
    repositories = []
    seen = set()
    for _ in range(MAX_PAGES):
        response = responseJSON(
            request(
                requests.get,
                "https://" + registry + "/api/v1/repository",
                params={
                    "public": str(public).lower(),
                    "last_modified": "true",
                    "next_page": next_page,
                },
            )
        )
        if not isinstance(response, dict) or not isinstance(response.get("repositories"), list):
            raise ValueError("Invalid repository response")
        for repo in response["repositories"]:
            if not isinstance(repo, dict) or any(
                not isinstance(repo.get(key), str)
                or repo[key] in ("", ".", "..")
                or "/" in repo[key]
                or any(ord(c) < 33 or ord(c) == 127 for c in repo[key])
                for key in ("namespace", "name")
            ):
                raise ValueError("Invalid repository entry")
        next_page = response.get("next_page")
        if next_page is not None and not isinstance(next_page, str):
            raise ValueError("Invalid pagination cursor")
        repositories.extend(response["repositories"])
        if next_page is None or next_page == "":
            return repositories
        if next_page in seen:
            raise ValueError("Repeated pagination cursor")
        seen.add(next_page)
    raise ValueError("Exceeded pagination page limit")


def repositoryURL(registry, repository):
    path = "/".join(quote(part, safe="") for part in repository.split("/"))
    return "https://" + registry + "/api/v1/repository/" + path


def getRepoTags(registry, repository):
    response = responseJSON(
        request(requests.get, repositoryURL(registry, repository), params={"includeTags": "true"})
    )
    if not isinstance(response, dict) or not isinstance(response.get("tags"), dict):
        raise ValueError("Invalid tags response")
    if any(not isinstance(value, dict) for value in response["tags"].values()):
        raise ValueError("Invalid tag entry")
    return response["tags"]


def listAllRepoTags(registry):
    rows = []
    for repo in getRepos(registry, True):
        repository = repo["namespace"] + "/" + repo["name"]
        tags = getRepoTags(registry, repository)
        rows.append({"repository": repository, "tags": ",".join(str(tag) for tag in tags)})
    return rows


def tagURL(registry, repository, tag):
    return repositoryURL(registry, repository) + "/tag/" + quote(tag, safe="")


def deleteTag(registry, repository, tag):
    response = request(requests.delete, tagURL(registry, repository, tag))
    if not response.content:
        return None
    return responseJSON(response)


def printAllTags(registry):
    rows = listAllRepoTags(registry)
    print("{:<60} {:<60}".format("Repository", "Tags"))
    print("=" * 120)
    for repo in rows:
        print("{:<60} {:<60}".format(repo["repository"], repo["tags"]))


def checkRegistry(registry, silent=False):
    if not silent:
        print("Checking Registry: " + registry + "...", file=sys.stderr)
    request(requests.get, "https://" + registry + "/api/v1/discovery")
    if not silent:
        print("[Quay: UP]", file=sys.stderr)
    return True


def main(argv):
    parser = argparse.ArgumentParser(description="Quay repository management script.")
    parser.add_argument("-r", "--registry", required=True, help="Registry hostname[:port]")
    parser.add_argument("-p", "--repo", dest="repository", help="Repository namespace/name")
    parser.add_argument("-t", "--tag", help="Tag to work on")
    parser.add_argument(
        "-a",
        "--action",
        default="printalltags",
        choices=("printalltags", "listtags", "listrepos", "deltag"),
    )
    parser.add_argument("-s", "--silent", action="store_true", help="Don't print checks")
    parser.add_argument("--yes", action="store_true", help="Confirm deletion without prompting")
    parser.add_argument(
        "--dry-run", action="store_true", help="Show deletion URL without network access"
    )
    parser.add_argument("--token-file", help="Read bearer token from file (overrides QRM_TOKEN)")
    args = parser.parse_args(argv)
    match = re.fullmatch(
        r"([A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::([0-9]+))?", args.registry
    )
    if not match or (match[2] and not 1 <= int(match[2]) <= 65535):
        parser.error("registry must be a hostname with optional port 1..65535")
    if (args.yes or args.dry_run) and args.action != "deltag":
        parser.error("--yes and --dry-run require --action deltag")
    if args.action in ("listtags", "deltag") and not args.repository:
        parser.error("repository not defined")
    if args.repository and (
        len(args.repository.split("/")) != 2
        or any(
            part in ("", ".", "..") or any(ord(c) < 33 or ord(c) == 127 for c in part)
            for part in args.repository.split("/")
        )
    ):
        parser.error("repository must be namespace/name")
    if args.action == "deltag" and not args.tag:
        parser.error("tag not defined")
    if args.tag is not None and (
        args.tag in ("", ".", "..") or any(ord(c) < 33 or ord(c) == 127 for c in args.tag)
    ):
        parser.error("Invalid tag")
    if args.action == "deltag":
        if args.dry_run:
            print(
                json.dumps(
                    {
                        "dry_run": True,
                        "method": "DELETE",
                        "url": tagURL(args.registry, args.repository, args.tag),
                    }
                )
            )
            return
        if not args.yes:
            if not sys.stdin.isatty():
                parser.error("deletion requires --yes or interactive confirmation")
            print(
                "Delete " + tagURL(args.registry, args.repository, args.tag) + "? Type yes: ",
                file=sys.stderr,
                end="",
                flush=True,
            )
            if sys.stdin.readline().strip() != "yes":
                parser.error("deletion cancelled")
    try:
        token = (
            Path(args.token_file).read_text(encoding="utf-8").strip()
            if args.token_file
            else os.environ.get("QRM_TOKEN")
        )
    except (OSError, UnicodeError):
        parser.error("Cannot read token file")
    if token is not None and (not token or any(not 33 <= ord(c) <= 126 for c in token)):
        parser.error("Invalid bearer token")
    if token:
        my_headers["Authorization"] = "Bearer " + token
    try:
        checkRegistry(args.registry, args.silent)
        if args.action == "printalltags":
            printAllTags(args.registry)
        elif args.action == "listtags":
            print(json.dumps(getRepoTags(args.registry, args.repository), indent=4))
        elif args.action == "listrepos":
            print(json.dumps(getRepos(args.registry, True), indent=4))
        else:
            print(json.dumps(deleteTag(args.registry, args.repository, args.tag), indent=4))
    except ValueError as error:
        print("ERROR: " + str(error), file=sys.stderr)
        raise SystemExit(1) from None
    finally:
        my_headers.pop("Authorization", None)


if __name__ == "__main__":
    main(sys.argv[1:])
