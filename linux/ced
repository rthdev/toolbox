#!/bin/bash
# Certificate Expiration Date: inspection only, not trust validation.
# shellcheck source=lib/tls.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/../lib/tls.sh" || exit 1
export LC_ALL=C
tls_args "$@"
command -v date >/dev/null || tls_error 'missing dependency: GNU date'
tls_fetch
expires=$(openssl x509 -in "$TLS_WORK/peer" -noout -enddate) || tls_error 'cannot parse certificate expiry'
expires=${expires#notAfter=}
end=$(date -u -d "$expires" +%s) || tls_error 'cannot convert expiry (GNU date required)'
now=$(date -u +%s) || tls_error 'cannot read current time'
# Floor, not truncation: any expired certificate has a negative day count.
seconds=$((end - now))
if ((seconds < 0)); then
    days=$(((seconds - 86399) / 86400))
else
    days=$((seconds / 86400))
fi
color='' reset=''
if [[ -t 1 && ! ${NO_COLOR+x} && -n ${TERM:-} && ${TERM:-} != dumb ]] && command -v tput >/dev/null; then
    index=2
    ((days < 90)) && index=3
    ((days < 30)) && index=1
    if color=$(tput setaf "$index" 2>/dev/null) && reset=$(tput sgr0 2>/dev/null); then
        :
    else
        color='' reset=''
    fi
fi
printf 'EXPIRES: %s%s%s\nDAYS REMAINING: %s\n' "$color" "$expires" "$reset" "$days"
