#!/bin/bash

# OpenShift Nodes Sorted by Role and Topology
# Lists nodes in order: Master, Infra, Worker
# Displays region and zone information

oc get nodes -o json | jq -r '
  .items
  | map(
      {
        name: .metadata.name,
        roles: (
          [
            (if .metadata.labels["node-role.kubernetes.io/master"] then "master" else empty end),
            (if .metadata.labels["node-role.kubernetes.io/infra"] then "infra" else empty end),
            (if .metadata.labels["node-role.kubernetes.io/worker"] then "worker" else empty end)
          ] | join(",")
        ),
        cpu: (.status.capacity.cpu // "N/A"),
        memory: (.status.capacity.memory // "N/A"),
        region: (.metadata.labels["topology.kubernetes.io/region"] // "N/A"),
        zone: (.metadata.labels["topology.kubernetes.io/zone"] // "N/A"),
        masterRole: (if .metadata.labels["node-role.kubernetes.io/master"] then 0 else 999 end),
        infraRole: (if .metadata.labels["node-role.kubernetes.io/infra"] then 1 else 999 end),
        workerRole: (if .metadata.labels["node-role.kubernetes.io/worker"] then 2 else 999 end)
      }
    )
  | map(
      .sortPriority = (
        if .masterRole == 0 then 0
        elif .infraRole == 1 then 1
        else 2
        end
      )
    )
  | sort_by(.sortPriority, .region, .zone)
  | .[] | "\(.name)|\(.roles)|\(.cpu)|\(.memory)|\(.region)|\(.zone)"
' | awk -F'|' '
  BEGIN {
    printf "%-30s %-20s %-8s %-15s %-20s %s\n", "NAME", "ROLES", "CPU", "MEMORY", "REGION", "ZONE"
  }
  {
    printf "%-30s %-20s %-8s %-15s %-20s %s\n", $1, $2, $3, $4, $5, $6
  }
'
